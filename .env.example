# Supabase — copy to .env.local and fill in real values from
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-side only. Never expose to the browser, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Admin portal (TEMP-SINGLE-ADMIN). Password checked server-side at /admin/login.
ADMIN_PASSWORD=REPLACE-WITH-REAL-ADMIN-PASSWORD
# Long random string (e.g. openssl rand -hex 32); signs the admin session cookie.
ADMIN_SESSION_SECRET=YOUR-RANDOM-64-CHAR-HEX
# Staff tier (TEMP-TWO-TIER). Grants role staff: field routes + quality desk only.
STAFF_PASSWORD=REPLACE-WITH-REAL-STAFF-PASSWORD

# Razorpay — TEST keys for now. Dashboard -> Settings -> API Keys.
# The key id reaches the browser when checkout opens (Razorpay publishes it by
# design); the other two are server-only and must never be committed.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR-TEST-KEY-SECRET
# Dashboard -> Settings -> Webhooks. Set the SAME value here and there.
# Webhook URL: https://YOUR-HOST/api/razorpay/webhook   Event: payment.captured
RAZORPAY_WEBHOOK_SECRET=YOUR-WEBHOOK-SECRET

# MSG91 — transactional SMS. NOT WIRED YET: no code reads these names today.
# They are fixed here first so the send path is written against a committed
# contract instead of inventing its own. Names and comments only, no values.
# All are server-only and must never reach the browser or be committed filled.

# Panel -> Settings -> API Keys. One key covers every template below.
MSG91_AUTH_KEY=
# The 6-char DLT-registered sender/header. Registered value: PDYLNK.
MSG91_SENDER_ID=
# DLT template id (the id, not the name) for PADDYLINK_LOGIN_OTP.
MSG91_TEMPLATE_ID_OTP=
# DLT template id for PADDYLINK_TOKEN_CREDIT. See 014_token_purchase_orders.sql
# — the credit notification is deliberately unsent until MSG91 is live.
MSG91_TEMPLATE_ID_TOKEN_CREDIT=
# DLT template id for PADDYLINK_UNLOCK.
MSG91_TEMPLATE_ID_UNLOCK=
