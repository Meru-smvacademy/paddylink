# Supabase — copy to .env.local and fill in real values from
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-side only. Never expose to the browser, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Admin portal (TEMP-SINGLE-ADMIN). Password checked server-side at /admin/login.
ADMIN_PASSWORD=REPLACE-WITH-REAL-ADMIN-PASSWORD
# Long random string (e.g. openssl rand -hex 32); signs the admin session cookie.
ADMIN_SESSION_SECRET=YOUR-RANDOM-64-CHAR-HEX
# Staff tier (TEMP-TWO-TIER). Grants role staff: field routes + quality desk only.
STAFF_PASSWORD=REPLACE-WITH-REAL-STAFF-PASSWORD

# Razorpay — TEST keys for now. Dashboard -> Settings -> API Keys.
# The key id reaches the browser when checkout opens (Razorpay publishes it by
# design); the other two are server-only and must never be committed.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR-TEST-KEY-SECRET
# Dashboard -> Settings -> Webhooks. Set the SAME value here and there.
# Webhook URL: https://YOUR-HOST/api/razorpay/webhook   Event: payment.captured
RAZORPAY_WEBHOOK_SECRET=YOUR-WEBHOOK-SECRET

# MSG91 — transactional SMS. The first three are READ by /api/otp/send; the
# two notification templates below are still unread (see the note on each).
# Names and comments only, no values. All are server-only and must never reach
# the browser or be committed filled.

# Panel -> Settings -> API Keys. One key covers every template below.
MSG91_AUTH_KEY=
# The 6-char DLT-registered sender/header. Registered value: PDYLNK.
MSG91_SENDER_ID=
# DLT template id (the id, not the name) for PADDYLINK_LOGIN_OTP.
MSG91_TEMPLATE_ID_OTP=
# NOT READ YET. DLT template id for PADDYLINK_TOKEN_CREDIT. See
# 014_token_purchase_orders.sql — the credit notification stays unsent until
# the notification processor is written.
MSG91_TEMPLATE_ID_TOKEN_CREDIT=
# NOT READ YET. DLT template id for PADDYLINK_UNLOCK.
MSG91_TEMPLATE_ID_UNLOCK=

# Signs the farmer and buyer session cookies, and keys the OTP code hashes
# stored by migration 016. Long random value: openssl rand -hex 32.
# DELIBERATELY NOT ADMIN_SESSION_SECRET — one leaked secret should cost one
# surface, not both. Rotating this signs every farmer and buyer out and voids
# every code in flight, which is the correct behaviour for a leak.
SESSION_SECRET=

# DEV ONLY, and ignored entirely when NODE_ENV=production. With this set to
# true, /api/otp/send does NOT call MSG91: it prints the code to the SERVER
# console so the login can be exercised on a machine that cannot receive SMS.
# It is not a bypass — the code still has to be typed, still expires in ten
# minutes, still burns attempts. Leave it unset unless you are testing.
# OTP_DEV_SKIP_SMS=true
